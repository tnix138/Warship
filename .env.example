# Copy to .env and adjust as needed. Every value has a working default.

# --- server (@warship/server) ---------------------------------------------
HOST=0.0.0.0
PORT=8080
SHARD_ID=shard-0
MAX_PLAYERS=100
WARSHIP_DB_FILE=data/warship.sqlite
LOG_LEVEL=debug

# --- client dev proxy (@warship/client, read by vite.config.ts) -----------
WARSHIP_SERVER_HOST=127.0.0.1
WARSHIP_SERVER_PORT=8080

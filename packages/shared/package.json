{
  "name": "@warship/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared constants, protocol types, formulas and upgrade definitions for WarShip.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -b tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  }
}

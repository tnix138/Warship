{
  "name": "@warship/client",
  "version": "0.0.0",
  "private": true,
  "description": "WarShip browser client (PixiJS v8 + Vite).",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b tsconfig.json",
    "assets:generate": "node scripts/generate-assets.mjs",
    "clean": "rimraf dist node_modules/.cache",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@warship/shared": "workspace:*",
    "pixi.js": "8.23.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "tsx": "^4.23.15"
  }
}

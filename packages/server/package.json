{
  "name": "@warship/server",
  "version": "0.0.0",
  "private": true,
  "description": "Authoritative WarShip game server (uWebSockets.js + Drizzle/SQLite).",
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -b tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@warship/shared": "workspace:*",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "uWebSockets.js": "https://codeload.github.com/uNetworking/uWebSockets.js/tar.gz/refs/tags/v20.52.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
